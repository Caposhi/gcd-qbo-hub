# GCD QBO Hub — safe local template
# Copy to .env.local. Values are fictional/disabled; never commit real secrets.

# Core
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://gcd_local:gcd_local@localhost:5432/gcd_qbo_hub_local?schema=public
APP_ENCRYPTION_KEY=

# NextAuth email magic-link authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ALLOWED_EMAIL_DOMAINS=example.invalid
BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
LEGAL_CONTACT_EMAIL=legal-contact@example.invalid
MAGIC_LINK_DEBUG=false

# Machine endpoints. Cron and Arcade fail closed while blank.
# Console state/stream fail open when blank, so this local-only value keeps them gated.
CONSOLE_TOKEN=local-development-console-token
CRON_SECRET=
ARCADE_BRIDGE_SECRET=
SYNC_TZ=America/New_York

# Google Sheets — set only for an approved non-production sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# QuickBooks Online — sandbox only for development
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# Anthropic — blank disables model calls
ANTHROPIC_API_KEY=

# Tekmetric — blank token/shop disables configured reads
TEKMETRIC_BASE_URL=https://sandbox.tekmetric.com
TEKMETRIC_TOKEN=
TEKMETRIC_SHOP_ID=

# Coworker Portal
COWORKER_QBO_ACCOUNT_NAME=Example Review Account

# SendGrid — blank key disables delivery
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@example.invalid
ALERT_SUMMARY_RECIPIENT=accounting-ops@example.invalid
ALERT_CRITICAL_RECIPIENT=incident-owner@example.invalid

# Aggregated transcript service — blank secret leaves integration unconfigured
TRANSCRIPTS_BASE_URL=https://transcripts.example.invalid
TRANSCRIPTS_SECRET=
